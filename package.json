{
  "name": "ibia",
  "version": "1.0.3",
  "main": "main.js",
  "description": "A lightweight desktop AI assistant with local and cloud model support.",
  "author": "Mark Chweya",
  "scripts": {
    "start": "npx electron .",
    "site": "npm --prefix website run dev",
    "site:build": "npm --prefix website run build",
    "pack": "electron-builder --dir",
    "pack:mac": "electron-builder --mac --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "pack:linux": "electron-builder --linux --dir",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "30.0.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.markchweya.ibia",
    "productName": "ibia",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "style.css",
      "package.json",
      "scripts/extract_assets.py",
      "build/icon.ico",
      "build/icon.icns",
      "build/icon.png",
      "build/entitlements.mac.plist",
      "!**/.env",
      "!**/.env.*",
      "!dist/**",
      "!website/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0",
        "NSHighResolutionCapable": true
      },
      "artifactName": "${productName}-${version}-macOS.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "A floating desktop AI assistant",
      "artifactName": "${productName}-${version}-Linux.${ext}"
    },
    "dmg": {
      "backgroundColor": "#10141f",
      "iconSize": 96
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "ibia"
    },
    "publish": null
  }
}
